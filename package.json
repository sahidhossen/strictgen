{
  "name": "strictgen",
  "version": "0.1.0",
  "description": "One JSON Schema. Strict Rust, Go and TypeScript types and decoders that accept and reject exactly the same JSON.",
  "keywords": [
    "json-schema",
    "codegen",
    "code-generator",
    "rust",
    "go",
    "golang",
    "typescript",
    "serde",
    "decoder",
    "validation",
    "strict",
    "llm",
    "structured-outputs"
  ],
  "license": "Apache-2.0",
  "author": "Sahid Hossen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahidhossen/strictgen.git"
  },
  "homepage": "https://github.com/sahidhossen/strictgen#readme",
  "bugs": {
    "url": "https://github.com/sahidhossen/strictgen/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "strictgen": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/conformance/",
    "!dist/snippets*",
    "profiles/",
    "strictgen.schema.json",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p playground/tsconfig.json",
    "test": "vitest run",
    "hygiene": "scripts/hygiene.sh",
    "conformance": "pnpm build && node dist/conformance/main.js",
    "fuzz": "pnpm build && node dist/conformance/fuzz-main.js",
    "playground:build": "node scripts/playground-build.mjs",
    "playground:serve": "node scripts/playground-serve.mjs",
    "vectors:llm": "STRICTGEN_WRITE_VECTORS=1 vitest run src/llm-vectors.test.ts",
    "examples": "pnpm build && node dist/cli.js generate --config examples/basic/strictgen.json && node dist/cli.js generate --config examples/report/strictgen.json && node dist/cli.js generate --config examples/llm/strictgen.json && node dist/cli.js generate --config examples/quickstart/strictgen.json",
    "examples:check": "pnpm build && node dist/cli.js check --config examples/basic/strictgen.json && node dist/cli.js check --config examples/report/strictgen.json && node dist/cli.js check --config examples/llm/strictgen.json && node dist/cli.js check --config examples/quickstart/strictgen.json",
    "docs": "pnpm build && node dist/snippets-main.js",
    "docs:check": "pnpm build && node dist/snippets-main.js --check",
    "binary": "pnpm build && node scripts/binary-build.mjs",
    "binary:smoke": "node scripts/binary-smoke.mjs",
    "package:check": "pnpm build && node scripts/package-check.mjs",
    "prepublishOnly": "node scripts/publish-guard.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/node": "^22",
    "ajv": "^8",
    "esbuild": "^0.28.2",
    "happy-dom": "21.0.4",
    "postject": "1.0.0-alpha.6",
    "typescript": "^6",
    "vitest": "^5"
  }
}
