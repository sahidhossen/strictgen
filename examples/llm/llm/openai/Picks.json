{
  "type": "object",
  "properties": {
    "value": {
      "description": "Lines to pick first.",
      "type": "array",
      "items": {
        "description": "One line of an order.",
        "type": "object",
        "properties": {
          "sku": {
            "description": "A stock keeping unit, like AB-1234.",
            "type": "string",
            "pattern": "^[A-Z]{2}-[0-9]{4}$"
          },
          "quantity": {
            "description": "How many, in packs of 2.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "multipleOf": 2
          },
          "price": {
            "description": "The unit price.",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "description": "Free form tags. No two items equal.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sku",
          "quantity",
          "price",
          "tags"
        ],
        "additionalProperties": false
      },
      "maxItems": 3
    }
  },
  "required": [
    "value"
  ],
  "additionalProperties": false
}
